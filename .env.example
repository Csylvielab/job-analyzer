# AI API Keys（至少配置一个）
DEEPSEEK_API_KEY=your_api_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here  # 支持内置搜索，推荐使用

# 搜索 API Keys（三选一，不配置则使用 Mock 假数据）
# 方案1: Google Custom Search API（免费 100次/天，需同时配置 API Key 和 Search Engine ID）
#   Step 1: 在 https://programmablesearchengine.google.com 创建搜索引擎，获得 cx ID
#   Step 2: 在 https://console.cloud.google.com 启用 "Custom Search API"，创建 API Key
GOOGLE_SEARCH_KEY=your_google_api_key_here
GOOGLE_SEARCH_CX=your_google_search_engine_id_here

# 方案2: SerpAPI（免费额度 100次/月，注册 https://serpapi.com）
SERPAPI_KEY=your_serpapi_key_here

# 方案3: Bing Search API（免费额度 1000次/月，需在 Azure 创建 Bing Search 资源）
BING_SEARCH_KEY=your_bing_search_key_here
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0
